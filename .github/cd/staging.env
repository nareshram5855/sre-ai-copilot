# Staging deployment defaults (override via GitHub Environment variables)
APP_ENV=staging
BACKEND_PORT=8080
K8S_NAMESPACE=sre-ai
K8S_DEPLOYMENT=sre-ai-backend
IMAGE_TAG=staging

# External services — set real values in GitHub → Settings → Environments → staging
CHROMA_HOST=chromadb.sre-ai.svc.cluster.local
CHROMA_PORT=8000
OLLAMA_BASE_URL=http://ollama.sre-ai.svc.cluster.local:11434
ALLOW_EXTERNAL_LLM=false
