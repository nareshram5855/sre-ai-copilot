# Copy to .env and fill in values
# .env is gitignored — never commit credentials

# ── Ollama (native macOS — no changes needed for local dev) ──────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.1

# ── ChromaDB (Minikube, port-forwarded to localhost:8000) ─────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── LLM Routing ───────────────────────────────────────────────────────────────
# Safety gate — must be explicitly enabled.
# Before setting to true, confirm data classification policy with your
# security/compliance team. All external calls are sanitized + audit-logged.
ALLOW_EXTERNAL_LLM=false

# Gemini Flash — recruiter resume bot only (free tier: 15 RPM, 1M tokens/day)
# Get key at: https://aistudio.google.com/app/apikey
# When set, the /api/v1/recruiter/ask/stream endpoint uses Gemini 1.5 Flash.
# SRE ops (chat/triage/runbook) always use local Ollama regardless of this key.
GOOGLE_API_KEY=

# Tier: ADVANCED + PREMIUM — Claude Haiku / Sonnet (~$2-9/mo)
ANTHROPIC_API_KEY=

# Routing threshold: alerts with fewer RAG hits than this are escalated
MIN_RAG_HITS_FOR_LOCAL=1

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Observability (Minikube synthetic stack) ────────────────────────────────
# Deploy:  make deploy-all
# Hybrid dev (backend on host): OBSERVABILITY_MODE=host + make dev-up
#   → starts PF daemon (:19090 Prom, :13100 Loki) with auto-restart after sleep
# In-cluster backend: OBSERVABILITY_MODE=incluster (cluster DNS, no port-forward)
OBSERVABILITY_MODE=host
PROMETHEUS_URL=http://localhost:19090
PROMETHEUS_UI_URL=http://localhost:19090
LOKI_URL=http://localhost:13100
LOKI_UI_URL=http://localhost:13100

# ── Phase 3: Integrations ─────────────────────────────────────────────────────

# Slack — Incoming Webhook URL for the #incidents channel
# Create at: https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=

# Redis — session/dedup persistence (falls back to in-memory when unavailable)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SESSION_TTL_SECONDS=14400
REDIS_DEDUP_TTL_SECONDS=86400

# LangGraph checkpoints — SQLite file (used when Redis checkpoint unavailable)
CHECKPOINT_SQLITE_PATH=backend/data/checkpoints.db

# Execution audit trail (append-only SQLite)
AUDIT_ENABLED=true
AUDIT_SQLITE_PATH=backend/data/audit.db

# In-memory session limits (dev fallback when REDIS_ENABLED=false)
SESSION_MAX_COUNT=500
SESSION_MAX_HISTORY=20
SESSION_TTL_SECONDS=3600

# ServiceNow — auto-create incidents from triage results
SERVICENOW_URL=
SERVICENOW_USER=
SERVICENOW_PASSWORD=

# Confluence — push RCA markdown to a Confluence page
CONFLUENCE_URL=
CONFLUENCE_TOKEN=

# ArgoCD — trigger sync from the health endpoint
ARGOCD_URL=
ARGOCD_TOKEN=

# ── Auth (API key gate for write endpoints: execute/approve/resolve/escalate) ─
# Leave empty in dev — bypass mode is active (a warning is logged at startup).
# Set a long random string in staging/prod to require X-API-Key header.
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Optional: set in the browser via localStorage under the key "sreai.apiKey",
# or inject at build-time via VITE_API_KEY in your CI pipeline.
VITE_API_KEY=

# ── PagerDuty (on-call paging) ────────────────────────────────────────────────
# Create a service in PagerDuty → Integrations → Events API v2.
# Copy the 32-char routing key here. Auto-pages P1 alerts on first fire.
PAGERDUTY_ROUTING_KEY=

# ── Minikube / cluster external IP ────────────────────────────────────────────
# Used by observability simulate endpoints and the Replicate guide.
# Override per machine — never commit a developer's local IP.
MINIKUBE_IP=192.168.105.3

# ── Kafka (real-time incident feed — deploy with make deploy-kafka) ────────────
# Port-forward first: make kafka-port-forward
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INCIDENT_TOPIC=sre.incidents.triage
KAFKA_ANOMALY_TOPIC=sre.observability.anomalies
KAFKA_CONSUMER_GROUP=sre-ai-copilot

# App profiler (runtime dashboard)
# GET /api/v1/profiler  — JSON stats for the UI
# GET /api/v1/metrics   — Prometheus text (app-level gauges; /metrics = FastAPI instrumentator)
