# Voice Module Configuration Example
# Copy relevant lines to your .env file to configure voice module

# ═════════════════════════════════════════════════════════════════════════════
# VOICE MODULE — GLOBAL SETTINGS
# ═════════════════════════════════════════════════════════════════════════════

# Enable/disable entire voice module (default: false)
# If false, no voice endpoints are registered — zero impact on existing code
VOICE_VOICE_ENABLED=true

# ═════════════════════════════════════════════════════════════════════════════
# STT (SPEECH-TO-TEXT) CONFIGURATION
# ═════════════════════════════════════════════════════════════════════════════

# Default STT provider: local, google-cloud, azure
VOICE_STT_PROVIDER=local

# Local STT settings
# Model sizes: whisper-tiny, whisper-small, whisper-base, whisper-medium, whisper-large
# Larger = better accuracy, slower and more memory
VOICE_STT_LOCAL_MODEL=whisper-base

# Default language for transcription (BCP-47 format)
VOICE_STT_LANGUAGE=en-US

# Google Cloud STT (if using)
# VOICE_GOOGLE_CLOUD_STT_ENABLED=false
# VOICE_GOOGLE_CLOUD_CREDENTIALS_PATH=/path/to/credentials.json

# Azure STT (if using)
# VOICE_AZURE_STT_ENABLED=false
# VOICE_AZURE_SPEECH_KEY=your_key_here
# VOICE_AZURE_SPEECH_REGION=eastus

# ═════════════════════════════════════════════════════════════════════════════
# TTS (TEXT-TO-SPEECH) CONFIGURATION
# ═════════════════════════════════════════════════════════════════════════════

# Default TTS provider: local, google-cloud, azure
VOICE_TTS_PROVIDER=local

# Local TTS backend: pyttsx3, espeak, gtts
VOICE_TTS_LOCAL_BACKEND=pyttsx3

# Default language for TTS (BCP-47 format)
VOICE_TTS_LANGUAGE=en-US

# Voice gender: male, female, neutral
VOICE_TTS_GENDER=neutral

# Speaking rate: 0.5 (half speed) to 2.0 (double speed)
VOICE_TTS_SPEAKING_RATE=1.0

# Audio output format: mp3, wav, ogg, m4a, webm
VOICE_TTS_AUDIO_FORMAT=mp3

# Google Cloud TTS (if using)
# VOICE_GOOGLE_CLOUD_TTS_ENABLED=false

# Azure TTS (if using)
# VOICE_AZURE_TTS_ENABLED=false

# ═════════════════════════════════════════════════════════════════════════════
# VOICE CHAT BEHAVIOR
# ═════════════════════════════════════════════════════════════════════════════

# Session timeout in seconds (1 hour default)
VOICE_VOICE_SESSION_TTL_SECONDS=3600

# Maximum audio upload size in bytes (50 MB default)
VOICE_VOICE_MAX_AUDIO_SIZE_BYTES=52428800

# Maximum audio duration in seconds (10 minutes default)
VOICE_VOICE_MAX_AUDIO_DURATION_SECONDS=600

# Audio chunk size for streaming (8 KB default)
VOICE_VOICE_STREAMING_CHUNK_SIZE_BYTES=8192

# ═════════════════════════════════════════════════════════════════════════════
# LOGGING & DEBUG
# ═════════════════════════════════════════════════════════════════════════════

# Log audio metadata (never content) — default: true
VOICE_VOICE_LOG_AUDIO_METADATA=true

# Return text fields (user transcription + LLM response) for debugging
# Set to true to get full debug info in API responses
VOICE_VOICE_DEBUG_RETURN_TEXT=false

# ═════════════════════════════════════════════════════════════════════════════
# PRESET CONFIGURATIONS
# ═════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# PRESET 1: Development (Local, Fast)
# Use smallest models for quick testing
# ─────────────────────────────────────────────────────────────────────────────
# VOICE_VOICE_ENABLED=true
# VOICE_STT_PROVIDER=local
# VOICE_STT_LOCAL_MODEL=whisper-tiny
# VOICE_TTS_PROVIDER=local
# VOICE_TTS_LOCAL_BACKEND=pyttsx3
# VOICE_VOICE_DEBUG_RETURN_TEXT=true


# ─────────────────────────────────────────────────────────────────────────────
# PRESET 2: Production (Local, Accurate)
# Use best local models for production accuracy
# ─────────────────────────────────────────────────────────────────────────────
# VOICE_VOICE_ENABLED=true
# VOICE_STT_PROVIDER=local
# VOICE_STT_LOCAL_MODEL=whisper-large
# VOICE_TTS_PROVIDER=local
# VOICE_TTS_LOCAL_BACKEND=pyttsx3
# VOICE_TTS_SPEAKING_RATE=0.9


# ─────────────────────────────────────────────────────────────────────────────
# PRESET 3: Google Cloud (Best Quality, Cost $$)
# Requires Google Cloud credentials and billing
# ─────────────────────────────────────────────────────────────────────────────
# VOICE_VOICE_ENABLED=true
# VOICE_STT_PROVIDER=google-cloud
# VOICE_GOOGLE_CLOUD_STT_ENABLED=true
# VOICE_GOOGLE_CLOUD_CREDENTIALS_PATH=/path/to/credentials.json
# VOICE_TTS_PROVIDER=google-cloud
# VOICE_GOOGLE_CLOUD_TTS_ENABLED=true


# ─────────────────────────────────────────────────────────────────────────────
# PRESET 4: Hybrid (Local + Cloud)
# Use local for speed, escalate to cloud for complex audio
# ─────────────────────────────────────────────────────────────────────────────
# VOICE_VOICE_ENABLED=true
# VOICE_STT_PROVIDER=local
# VOICE_STT_LOCAL_MODEL=whisper-medium
# VOICE_TTS_PROVIDER=google-cloud


# ═════════════════════════════════════════════════════════════════════════════
# NOTES
# ═════════════════════════════════════════════════════════════════════════════

# 1. This is a PLUGIN — voice module is completely independent
#
# 2. Default configuration:
#    - Voice disabled (VOICE_VOICE_ENABLED=false)
#    - Zero impact on existing code when disabled
#    - No performance penalties
#
# 3. Local vs Cloud:
#    - Local (default): Free, privacy-first, latency 4-10 seconds
#    - Cloud (optional): Better accuracy, cost $0.01-$0.10 per request
#
# 4. Language Support:
#    - Add domain hints for better accuracy in SRE context
#    - See VOICE_SRE_DOMAIN_HINTS in backend/voice/config.py
#
# 5. Performance Tips:
#    - Use whisper-base for good balance of speed/accuracy
#    - Lower TTS speaking rate (0.8) for clearer pronunciation
#    - Enable debug mode temporarily for troubleshooting
